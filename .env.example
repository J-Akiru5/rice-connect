# RiceConnect environment template.
#
# Next.js reads .env.local from each app's own directory. Copy the "Every app" block into:
#   apps/main/.env.local
#   apps/buyer/.env.local
#   apps/driver/.env.local
#   apps/farmer/.env.local
# Real values never go in the repo: .env* is gitignored (this template is the only exception).

# ---------------------------------------------------------------------------
# Every app — ANNI (Google Gemini, decision M42)
# ---------------------------------------------------------------------------
# Server-only. Never add a NEXT_PUBLIC_ prefix or the key reaches the browser.
GEMINI_API_KEY=
# Optional; code defaults are shown.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_THINKING_LEVEL=low

# ---------------------------------------------------------------------------
# Every app — Supabase (Phase 3, decisions M43/B-01)
# ---------------------------------------------------------------------------
# Project URL from the dashboard, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable anon key. Safe in the browser: row-level security does the access control.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (admin tasks, audit writes, RLS-bypassing jobs). Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Every app — mode
# ---------------------------------------------------------------------------
# demo | live (default demo). live turns on route guards and hides the DemoChip.
NEXT_PUBLIC_RC_MODE=demo

# ---------------------------------------------------------------------------
# Owner / CLI only — do NOT put these in any app's .env.local, and never commit them
# ---------------------------------------------------------------------------
# Supabase dashboard -> Account -> Access Tokens
SUPABASE_ACCESS_TOKEN=
# The database password chosen when each project was created.
SUPABASE_DB_PASSWORD=
# Project refs, used by: pnpm exec supabase link --project-ref <ref>
SUPABASE_PROJECT_REF_DEV=
SUPABASE_PROJECT_REF_STAGING=
SUPABASE_PROJECT_REF_PROD=
