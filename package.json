{
  "name": "riceconnect",
  "private": true,
  "description": "RiceConnect Enactus 2026 prototype monorepo: simulated data only.",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "demo:local": "node scripts/demo-local.mjs",
    "build:local": "node scripts/demo-local.mjs --build-only"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "prettier": "3.9.9",
    "turbo": "2.11.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0"
    }
  }
}
