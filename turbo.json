{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "src/styles/tokens.css"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    }
  },
  "globalEnv": ["RC_LOCAL", "NEXT_PUBLIC_RC_MODE", "NEXT_PUBLIC_VERCEL_ENV"],
  "globalPassThroughEnv": ["NEXT_TELEMETRY_DISABLED"]
}
